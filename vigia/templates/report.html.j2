<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reporte de seguridad — Vigía</title>
<style>
:root {
  --bg: #0f1117;
  --surface: #171a23;
  --surface-2: #1e222d;
  --border: #2a2f3c;
  --text: #e6e8ee;
  --muted: #9aa2b1;
  --accent: #6ea8fe;
  --alta: #f0616d;
  --media: #f0a84e;
  --baja: #57b6d9;
  --info: #8a93a6;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.5;
}
.wrap { max-width: 960px; margin: 0 auto; padding: 40px 24px 80px; }
header.report { border-bottom: 1px solid var(--border); padding-bottom: 24px; margin-bottom: 32px; }
.brand { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
h1 { font-size: 26px; margin: 8px 0 4px; }
.target { color: var(--muted); font-size: 14px; word-break: break-all; }
.meta { color: var(--muted); font-size: 13px; margin-top: 12px; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin: 28px 0; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
.card .num { font-size: 28px; font-weight: 700; }
.card .lbl { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 4px; }
.card.alta .num { color: var(--alta); }
.card.media .num { color: var(--media); }
.card.baja .num { color: var(--baja); }
.card.info .num { color: var(--info); }
.finding { background: var(--surface); border: 1px solid var(--border); border-left-width: 4px; border-radius: 10px; padding: 20px 22px; margin-bottom: 16px; }
.finding.alta { border-left-color: var(--alta); }
.finding.media { border-left-color: var(--media); }
.finding.baja { border-left-color: var(--baja); }
.finding.info { border-left-color: var(--info); }
.finding-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.finding-head h3 { margin: 0; font-size: 17px; flex: 1 1 auto; }
.pill { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
.pill.alta { background: rgba(240,97,109,0.16); color: var(--alta); }
.pill.media { background: rgba(240,168,78,0.16); color: var(--media); }
.pill.baja { background: rgba(87,182,217,0.16); color: var(--baja); }
.pill.info { background: rgba(138,147,166,0.16); color: var(--info); }
.owasp { font-size: 12px; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 3px 9px; }
.field { margin-top: 14px; }
.field .k { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 4px; }
.field .v { font-size: 14px; }
.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; font-size: 13px; word-break: break-word; white-space: pre-wrap; }
.empty { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 40px; text-align: center; color: var(--muted); }
footer.report { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--muted); font-size: 12px; }
@media (prefers-color-scheme: light) {
  :root { --bg: #f6f7f9; --surface: #ffffff; --surface-2: #f0f2f5; --border: #dfe3ea; --text: #1a1d24; --muted: #5c6473; }
}
</style>
</head>
<body>
<div class="wrap">
  <header class="report">
    <div class="brand">Vigía · Reporte de seguridad</div>
    <h1>Resultados del escaneo</h1>
    <div class="target">{{ summary.target }}</div>
    <div class="meta">
      Generado: {{ summary.generated_at }} &nbsp;·&nbsp;
      Páginas rastreadas: {{ summary.pages_crawled }} &nbsp;·&nbsp;
      Hallazgos: {{ summary.total_findings }}
    </div>
  </header>

  <section class="cards">
    {% for sev in severity_order %}
    <div class="card {{ sev.value }}">
      <div class="num">{{ summary.counts[sev.value] }}</div>
      <div class="lbl">{{ severity_labels[sev] }}</div>
    </div>
    {% endfor %}
  </section>

  {% if findings %}
    {% for f in findings %}
    <article class="finding {{ f.severity.value }}">
      <div class="finding-head">
        <span class="pill {{ f.severity.value }}">{{ severity_labels[f.severity] }}</span>
        <h3>{{ f.title }}</h3>
        <span class="owasp">{{ f.owasp.code }} · {{ f.owasp.name }}</span>
      </div>
      <div class="field">
        <div class="k">URL afectada</div>
        <div class="v mono">{{ f.request_method }} {{ f.url }}{% if f.parameter %}  (parámetro: {{ f.parameter }}){% endif %}</div>
      </div>
      <div class="field">
        <div class="k">Evidencia</div>
        <div class="v mono">{{ f.evidence }}</div>
      </div>
      <div class="field">
        <div class="k">Remediación</div>
        <div class="v">{{ f.remediation }}</div>
      </div>
    </article>
    {% endfor %}
  {% else %}
    <div class="empty">No se encontraron hallazgos. El objetivo superó todas las comprobaciones ejecutadas.</div>
  {% endif %}

  <footer class="report">
    Vigía es una herramienta de detección defensiva. Úsala solo contra sistemas propios o con autorización escrita.
  </footer>
</div>
</body>
</html>
